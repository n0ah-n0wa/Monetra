# Monetra environment configuration
# Copy to `.env` and adjust values for local development.
# Never commit real secrets.

# Application
APP_NAME=Monetra
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=text
SERVICE_NAME=monetra-backend
ACCESS_LOG_ENABLED=true
ACCESS_LOG_SKIP_PATHS=/health
OTEL_ENABLED=false
OTEL_EXPORTER=otlp
# SENTRY_DSN=
API_V1_PREFIX=/api/v1

# PostgreSQL
POSTGRES_DB=monetra
POSTGRES_USER=monetra
POSTGRES_PASSWORD=monetra
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://monetra:monetra@localhost:5432/monetra

# Backend
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_PASSWORD_REQUIRE_LETTER=true
AUTH_PASSWORD_REQUIRE_DIGIT=true
REFRESH_TOKEN_COOKIE_NAME=monetra_refresh_token
REFRESH_TOKEN_COOKIE_PATH=/api/v1/auth
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_SAMESITE=lax
AUTH_RATE_LIMIT_MAX_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
PASSWORD_RESET_EMAIL_RATE_LIMIT_MAX_REQUESTS=3
PASSWORD_RESET_REQUEST_COOLDOWN_SECONDS=300
# Set to 1 when the API sits behind nginx (production default).
TRUSTED_PROXY_COUNT=0


# Exchange rates (SPEC §23)
# Provider: none | static | test  (no API credentials — providers are swappable)
EXCHANGE_RATE_PROVIDER=none
# Comma-separated BASE:QUOTE:RATE triples used when provider=static
# Example: EUR:USD:1.1,GBP:USD:1.25
EXCHANGE_RATE_STATIC_RATES=
# In-memory provider cache TTL (seconds). 0 disables caching.
EXCHANGE_RATE_CACHE_TTL_SECONDS=300
# On provider failure, return a previously cached (stale) quote when available.
EXCHANGE_RATE_ALLOW_STALE_ON_FAILURE=true

# CSV import
IMPORT_MAX_FILE_BYTES=5242880
IMPORT_MAX_ROWS=10000
IMPORT_PREVIEW_LIMIT=50

# CSV export
EXPORT_MAX_ROWS=10000

# Load testing (local only — never point at production)
LOADTEST_BASE_URL=http://127.0.0.1:8000
LOADTEST_EMAIL=loadtest-user@example.com
LOADTEST_PASSWORD=LoadTest1!
LOADTEST_CONCURRENCY=8
LOADTEST_ITERATIONS=40
LOADTEST_TRANSACTION_COUNT=1200
LOADTEST_BUDGET_COUNT=5
NGINX_PORT=80
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Optional dev-only workaround for npm TLS issues inside Docker on some hosts.
# Never set in production builds or images.
# NODE_TLS_REJECT_UNAUTHORIZED=0
