# Monetra environment configuration
# Copy to `.env` and adjust values for local development.
# Never commit real secrets.

# Application
APP_NAME=Monetra
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# PostgreSQL
POSTGRES_DB=monetra
POSTGRES_USER=monetra
POSTGRES_PASSWORD=monetra
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://monetra:monetra@localhost:5432/monetra

# Backend
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=
VITE_PROXY_TARGET=http://localhost:8000

# Nginx
NGINX_PORT=80
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
