# Production deployment environment (copy to `.env` before `docker compose -f docker-compose.prod.yml up`)
# Never commit real secrets.

APP_NAME=Monetra
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json
SERVICE_NAME=monetra-backend
ACCESS_LOG_ENABLED=true
ACCESS_LOG_SKIP_PATHS=/health
OTEL_ENABLED=false

POSTGRES_DB=monetra
POSTGRES_USER=monetra
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# Required: at least 32 characters, not the development default.
JWT_SECRET_KEY=replace-with-a-long-random-production-secret

CORS_ORIGINS=https://localhost,https://127.0.0.1
TRUSTED_PROXY_COUNT=1

AUTH_RATE_LIMIT_MAX_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

EXCHANGE_RATE_PROVIDER=none
EXCHANGE_RATE_CACHE_TTL_SECONDS=300
EXCHANGE_RATE_ALLOW_STALE_ON_FAILURE=true

IMPORT_MAX_FILE_BYTES=5242880
IMPORT_MAX_ROWS=10000
IMPORT_PREVIEW_LIMIT=50
EXPORT_MAX_ROWS=10000

NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Optional edge proxy tuning (defaults are production-safe).
# NGINX_SERVER_NAME=_
# NGINX_CLIENT_MAX_BODY_SIZE=10m
# NGINX_HSTS_MAX_AGE=31536000
# NGINX_CSP=default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'

# Set false only for debugging migration issues.
RUN_DB_MIGRATIONS=true
